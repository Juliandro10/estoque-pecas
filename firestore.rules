rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isLoggedIn() {
      return request.auth != null;
    }

    function isPainelAccount() {
      return isLoggedIn()
        && request.auth.token.email == 'tecelagem@controle-tricot-e-cia.web.app';
    }

    function isDesenvBoardAccount() {
      return isLoggedIn()
        && request.auth.token.email == 'desenvolvimentos@controle-tricot-e-cia.web.app';
    }

    function isValidPublicJson(maxSize) {
      let data = request.resource.data;
      return data.keys().hasOnly(['json', 'updated_at'])
        && data.json is string
        && data.json.size() > 2
        && data.json.size() < maxSize
        && data.updated_at is string
        && data.updated_at.size() >= 10
        && data.updated_at.size() < 80;
    }

    match /tecelagem_publico/{document} {
      allow read: if true;
      allow create, update: if isLoggedIn() && isValidPublicJson(200000);
      allow delete: if isLoggedIn() && !isPainelAccount();
    }

    match /desenv_publico/{document} {
      allow read: if true;
      allow create, update: if isLoggedIn() && isValidPublicJson(400000);
      allow delete: if isLoggedIn() && !isPainelAccount();
    }

    match /cadastro_custo_publico/{document} {
      allow read: if true;
      allow create, update: if isLoggedIn() && isValidPublicJson(200000);
      allow delete: if isLoggedIn() && !isPainelAccount();
    }

    match /cadastro_custo_pdf/{document} {
      allow read: if true;
      allow create, update: if isLoggedIn() && isValidPublicJson(900000);
      allow delete: if isLoggedIn() && !isPainelAccount();
    }

    match /desenvolvimentos/{id} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn() && !isPainelAccount();
    }

    match /syntech_catalog/{id} {
      allow read: if isLoggedIn();
      allow create, update: if isLoggedIn() && isValidPublicJson(900000);
      allow delete: if isLoggedIn() && !isPainelAccount() && !isDesenvBoardAccount();
    }

    match /syntech_cadastros/{id} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && !isPainelAccount()
        && request.resource.data.status == 'pendente'
        && request.resource.data.codigo is string;
      allow update: if isLoggedIn();
      allow delete: if isLoggedIn() && !isPainelAccount() && !isDesenvBoardAccount();
    }

    match /{document=**} {
      allow read, write: if isLoggedIn() && !isPainelAccount() && !isDesenvBoardAccount();
    }
  }
}
