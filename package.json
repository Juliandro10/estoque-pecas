{
  "name": "estoque-pecas",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:scanner": "tsx watch server/programs-scanner.ts",
    "painel": "tsx painel-tecelagem/server.ts",
    "desenv": "tsx painel-desenvolvimentos/server.ts",
    "painel:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-painel-installer.ps1",
    "desenv:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desenv-installer.ps1",
    "dev:local": "concurrently -n web,scan -c magenta,cyan \"npm run dev\" \"npm run dev:scanner\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "import:estoque": "tsx scripts/import-estoque.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:local": "tsx scripts/backup.ts -- --local-only",
    "restore:backup": "tsx scripts/restore-backup.ts",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:hosting": "npm run build && node scripts/copy-painel-hosting.mjs && firebase deploy --only hosting",
    "deploy": "npm run build && node scripts/copy-painel-hosting.mjs && firebase deploy --only firestore:rules,hosting",
    "painel:cloud-user": "tsx scripts/ensure-painel-firebase-user.ts",
    "desenv:cloud-user": "tsx scripts/ensure-desenv-firebase-user.ts"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "cfb": "^1.2.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase": "^11.10.0",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "node-firebird": "^2.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.0",
    "firebase-admin": "^13.4.0",
    "firebase-tools": "^14.9.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
