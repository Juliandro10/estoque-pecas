VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Conta só para o PC da tecelagem enviar o quadro (não é login do Estoque).
# PAINEL_FIREBASE_EMAIL=tecelagem@controle-tricot-e-cia.web.app
# PAINEL_FIREBASE_PASSWORD=

# Editor de imagem do Desenv-M1. Chave em Cursor Dashboard → API Keys. Só no servidor.
# CURSOR_API_KEY=

# IA local (Ollama) da opção Local no editor M1. O scanner lê as duas no .env.
# Outros projetos neste PC podem seguir o mesmo par: OLLAMA_URL e OLLAMA_MODEL.
# Com as linhas comentadas, o padrão é http://127.0.0.1:11434 e qwen3:30b-a3b.
# Se o modelo não estiver instalado, o editor mostra: ollama pull <modelo>
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:30b-a3b

# Pastas de programas (separadas por ;). O scanner busca em todas.
# PROGRAMS_ROOTS=H:\Outros computadores\Desenvolvimento\PROGRAMAS\PROGRAMAS-POR-CLIENTE;H:\Outros computadores\Meu computador\PROGRAMAS-HOME;G:\Outros computadores\Desenvolvimento;G:\Outros computadores\Meu computador\PROGRAMAS-HOME;C:\Users\Tricot&Cia\Desktop\PROGRAMAS
